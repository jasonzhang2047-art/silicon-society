---
import { CATEGORIES, weeklyCounts } from "../lib/data";
import { shortDate } from "../lib/format";

/** Signals per week — single series, so the title names it and no legend box is needed. */
interface Props { weeks?: number }
const { weeks = 12 } = Astro.props;
const data = weeklyCounts(weeks);

const W = 560, H = 210, padL = 34, padR = 8, padT = 14, padB = 28;
const plotW = W - padL - padR, plotH = H - padT - padB;
const max = Math.max(1, ...data.map((d) => d.total));
const step = max <= 10 ? 2 : max <= 25 ? 5 : max <= 60 ? 10 : max <= 150 ? 25 : 50;
const top = Math.ceil(max / step) * step;
const ticks = Array.from({ length: top / step + 1 }, (_, i) => i * step);
const band = plotW / data.length;
const barW = Math.min(24, band * 0.62);
const y = (v: number) => padT + plotH - (v / top) * plotH;
const r = 4;

function colPath(x: number, v: number) {
  const yTop = y(v), base = y(0);
  if (v === 0) return "";
  const rr = Math.min(r, (base - yTop) / 2, barW / 2);
  return `M${x},${base} V${yTop + rr} Q${x},${yTop} ${x + rr},${yTop} H${x + barW - rr} Q${x + barW},${yTop} ${x + barW},${yTop + rr} V${base} Z`;
}
const tipFor = (d: (typeof data)[number], i: number) => {
  const rows = CATEGORIES.filter((c) => d.byCat[c.id])
    .map((c) => `<div class="row"><span>${c.label}</span><span>${d.byCat[c.id]}</span></div>`)
    .join("");
  const label = i === data.length - 1 ? `Week of ${shortDate(d.start)} (so far)` : `Week of ${shortDate(d.start)}`;
  return `<strong>${label}</strong><div class="row"><span>Signals</span><span>${d.total}</span></div>${rows}`;
};
const last = data[data.length - 1];
const prev = data[data.length - 2];
---
<figure class="weekly">
  <figcaption>
    <span class="eyebrow">Signals per week · last {weeks} weeks</span>
  </figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Signals tracked per week over the last ${weeks} weeks. Most recent full week: ${prev?.total ?? 0}.`}>
    {ticks.map((t) => (
      <g>
        <line x1={padL} x2={W - padR} y1={y(t)} y2={y(t)} class={t === 0 ? "base" : "grid"} />
        <text x={padL - 8} y={y(t) + 3.5} text-anchor="end" class="tick">{t}</text>
      </g>
    ))}
    {data.map((d, i) => {
      const x = padL + i * band + (band - barW) / 2;
      const current = i === data.length - 1;
      return (
        <g class="col" tabindex="0" data-tip={tipFor(d, i)} aria-label={`Week of ${shortDate(d.start)}: ${d.total} signals`}>
          <rect x={padL + i * band} y={padT} width={band} height={plotH} class="hit" />
          <path d={colPath(x, d.total)} class:list={["bar", { current }]} />
          {(i % 3 === 2 || current) && (
            <text x={x + barW / 2} y={H - 8} text-anchor="middle" class="tick">{current ? "This wk" : shortDate(d.start)}</text>
          )}
        </g>
      );
    })}
    {last && last.total > 0 && (
      <text x={padL + (data.length - 1) * band + band / 2} y={y(last.total) - 6} text-anchor="middle" class="val">{last.total}</text>
    )}
  </svg>
</figure>

<style>
  .weekly {
    margin: 0;
  }
  figcaption {
    margin-bottom: 8px;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .grid {
    stroke: var(--hairline);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .base {
    stroke: var(--axis);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .tick {
    font: 10.5px var(--mono);
    fill: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .val {
    font: 600 12px var(--sans);
    fill: var(--ink);
  }
  .bar {
    fill: var(--chart);
    opacity: 0.85;
    transition: opacity 0.12s;
  }
  .bar.current {
    opacity: 1;
  }
  .hit {
    fill: transparent;
  }
  .col {
    cursor: default;
    outline: none;
  }
  .col:hover .hit,
  .col:focus-visible .hit {
    fill: var(--wash);
  }
  .col:hover .bar {
    opacity: 1;
  }
</style>
